{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(**)",
      "Bash(bash scripts/check/gates.sh:*)",
      "Bash(bash scripts/check/coverage.sh:*)",
      "Bash(bash scripts/check/error-codes.sh:*)",
      "Bash(bash scripts/check/lint-suppressions.sh:*)",
      "Bash(bash scripts/check/package-graph.sh:*)",
      "Bash(bash scripts/check/privacy-manifest.sh:*)",
      "Bash(bash scripts/check/xcode-settings.sh:*)",
      "Bash(node scripts/check/i18n-catalog.mjs:*)",
      "Bash(bash scripts/ios/app.sh:*)",
      "Bash(bash scripts/ios/api-client.sh:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swiftlint lint:*)",
      "Bash(xcrun swift-format lint:*)",
      "Bash(xcrun swift-format format:*)"
    ],
    "ask": [
      "mcp__db-prod__execute_sql",
      "Edit(.claude/agent-config.json)",
      "Edit(.claude/agent-config-kit.lock)",
      "Edit(.claude/hooks/**)",
      "Edit(scripts/check/hook-probes.*)",
      "Edit(scripts/ops/unlock.sh)",
      "Edit(scripts/env/**)",
      "Bash(xcodebuild:*)",
      "Bash(swift package:*)",
      "Bash(swift run:*)",
      "Bash(xcrun simctl:*)",
      "Bash(bash scripts/deploy/verify-deploy.sh:*)",
      "Bash(bash ./scripts/deploy/verify-deploy.sh:*)",
      "Bash(./scripts/deploy/verify-deploy.sh:*)",
      "Bash(scripts/deploy/verify-deploy.sh:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push origin dev:*)",
      "Bash(git push origin prod:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Edit(.env*)",
      "Edit(!.env*.example)",
      "Edit(.claude/state/**)",
      "Read(.env*)",
      "Read(!.env*.example)",
      "Read(.claude/state/env-backups/**)",
      "Edit(AGENTS.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "bash scripts/env/show.sh*",
      "bash scripts/env/set.sh*",
      "./scripts/env/show.sh*",
      "./scripts/env/set.sh*",
      "scripts/env/show.sh*",
      "scripts/env/set.sh*"
    ],
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.*",
        ".env-*",
        ".env_*",
        ".envrc",
        "./**/.env",
        "./**/.env.*",
        "./**/.env-*",
        "./**/.env_*",
        "./**/.envrc",
        ".claude/state/env-backups",
        ".claude/state/env-backups/**"
      ],
      "allowRead": [
        ".env.example",
        ".env.*.example",
        ".env-*.example",
        ".env_*.example",
        "./**/.env.example",
        "./**/.env.*.example",
        "./**/.env-*.example",
        "./**/.env_*.example"
      ],
      "denyWrite": [
        ".claude/state/unlock",
        ".claude/state/unlock/**"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "agent-config-kit": {
      "source": {
        "source": "github",
        "repo": "adhibuchori/agent-config-kit"
      }
    }
  },
  "enabledPlugins": {
    "agent-core@agent-config-kit": true
  }
}
